# ---------------------------------------------------------------------------
# CommChecker configuration
#
# Copy this file to ".env" and edit it, or set these as environment variables
# in your hosting dashboard. Every setting is explained in CONFIGURATION.md.
#
# The defaults below run the local demo. The lines marked PRODUCTION are the
# ones you change when you go live.
# ---------------------------------------------------------------------------

# Which certificate to seal with: "demo" or "production".
COMMCHECKER_MODE=demo

# --- PRODUCTION: your certificate from a Certificate Authority -------------
# The .p12 (sometimes .pfx) file the CA gives you, and its password.
#COMMCHECKER_MODE=production
#COMMCHECKER_P12_PATH=/etc/commchecker/commlocker-signing.p12
#COMMCHECKER_P12_PASSWORD=the-password-the-CA-gave-you

# Safer alternative: keep the password in a file instead of a variable.
#COMMCHECKER_P12_PASSWORD_FILE=/run/secrets/commchecker-cert-password

# For hosts with no permanent disk, supply the certificate as base64 text:
#   base64 -w0 commlocker-signing.p12
#COMMCHECKER_P12_BASE64=MIIKx...

# If your CA sent separate intermediate certificates, point at them here.
#COMMCHECKER_P12_CHAIN_PATH=/etc/commchecker/intermediates.pem

# --- DEMO: sharing one demo certificate with a hosted demo ----------------
# A deployed server makes its own demo certificate and loses it on every
# deploy, so PDFs you sealed on your laptop would be rejected as coming from
# an unknown signer. Give both machines the same one:
#   python cli.py init
#   base64 -w0 demo.p12
# Paste the result here (and set it on your host too).
#COMMCHECKER_DEMO_P12_BASE64=MIIKx...

# --- Trusted timestamp (RFC-3161) ------------------------------------------
# Proves WHEN the document was sealed. Only a hash is sent, never the document.
# Leave blank to switch timestamping off.
COMMCHECKER_TSA_URL=http://timestamp.digicert.com
#COMMCHECKER_TSA_USERNAME=
#COMMCHECKER_TSA_PASSWORD=
COMMCHECKER_TSA_TIMEOUT=10

# Refuse to seal at all if the timestamp cannot be obtained.
# Defaults to ON in production, OFF in demo.
#COMMCHECKER_TSA_REQUIRED=1

# --- Trust settings (used when checking a seal) ----------------------------
# Trust the public Certificate Authorities the operating system already trusts.
# Turn this ON in production so real CA-issued seals verify.
#COMMCHECKER_TRUST_SYSTEM_ROOTS=1

# Additionally trust specific certificates: a .pem file, or a folder of them.
#COMMCHECKER_TRUST_ROOTS=/etc/commchecker/trusted-roots

# Check online whether a certificate has been revoked. Needs outbound internet.
#COMMCHECKER_ALLOW_FETCHING=1

# --- Behaviour --------------------------------------------------------------
# Store a short excerpt of each record in the manifest so the report can show
# "was / is now". Set to 0 for hash-only manifests.
COMMCHECKER_MANIFEST_PREVIEWS=1

# Largest PDF the web service will accept, in megabytes.
COMMCHECKER_MAX_UPLOAD_MB=25
